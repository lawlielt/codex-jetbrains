<idea-plugin>
    <id>com.openai.codex.jetbrains</id>
    <name>Codex</name>
    <vendor url="https://openai.com/codex">OpenAI</vendor>

    <description><![CDATA[
      Launch the interactive Codex CLI in a dedicated JetBrains Terminal tab at
      the current project root. Codex owns authentication, model selection,
      permissions, configuration, and session state in the terminal.
    ]]></description>

    <change-notes><![CDATA[
      <ul><li>0.2.0: Replace the app-server chat tool window with a terminal-first Codex CLI launcher.</li></ul>
    ]]></change-notes>

    <idea-version since-build="242"/>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="plugin-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Codex"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="com.openai.codex.jetbrains.OpenTerminal"
                class="com.openai.codex.jetbrains.actions.OpenCodexTerminalAction"
                text="Codex"
                description="Open Codex in the built-in Terminal"
                icon="/icons/codex.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
